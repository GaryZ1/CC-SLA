# Names of secrets only. Values come from the secret manager / Databricks secret scopes, never from this file.
# DATABRICKS_HOST=
# DATABRICKS_SQL_WAREHOUSE_ID=
# DATABRICKS_CLIENT_ID=
# DATABRICKS_CLIENT_SECRET=      (injected by the controller's credential broker only)
# SRCDB_READER_PASSWORD=         (Q-14/Q-15: source database reader identity)

# Non-secret overrides the harness honors (see docs/configuration.md):
# HARNESS_ARTIFACTS_DIR=artifacts
# HARNESS_STATE_DIR=state
# HARNESS_LOG_LEVEL=INFO
