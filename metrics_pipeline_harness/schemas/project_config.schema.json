  "$id": "metrics_pipeline_harness/project_config.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "access": {
      "$ref": "#/$defs/Access"
    },
    "approvals": {
      "$ref": "#/$defs/Approvals"
    },
    "decisions": {
      "items": {
        "$ref": "#/$defs/Decision"
      },
      "title": "Decisions",
      "type": "array"
    },
    "governance": {
      "$ref": "#/$defs/Governance"
    },
    "inputs": {
      "$ref": "#/$defs/Inputs"
    },
    "llm": {
      "$ref": "#/$defs/LlmPolicy"
    },
    "local_reference": {
      "$ref": "#/$defs/LocalReference"
    },
    "mode": {
      "$ref": "#/$defs/Mode"
    },
    "operational": {
      "$ref": "#/$defs/Operational",
      "default": {
        "artifacts_dir": "artifacts",
        "log_level": "INFO",
        "state_dir": "state"
      }
    },
    "production": {
      "$ref": "#/$defs/Production"
    },
    "project_name": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "title": "Project Name",
      "type": "string"
    },
    "schema_version": {
      "const": "project_config/1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "semantics": {
      "$ref": "#/$defs/Semantics"
    },
    "sources": {
      "$ref": "#/$defs/Sources"
    },
    "workload": {
      "$ref": "#/$defs/Workload"
    }
  },
  "required": [
    "schema_version",
    "project_name",
    "mode",
    "decisions",
    "inputs",
    "local_reference",
    "llm",
    "approvals",
    "access",
    "production",
    "semantics",
    "sources",
    "workload",
    "governance"
  ],
  "title": "ProjectConfig",
  "type": "object"
}
