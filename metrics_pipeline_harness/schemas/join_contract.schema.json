{
  "$defs": {
    "EvidenceStatus": {
      "enum": [
        "ORIGINAL_ONLY",
        "PROPOSED",
        "OWNER_CONFIRMED",
        "CATALOG_VERIFIED",
        "PROFILE_VERIFIED",
        "SYNTHETIC"
      ],
      "title": "EvidenceStatus",
      "type": "string"
    }
  },
  "$id": "metrics_pipeline_harness/join_contract.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "dedup_policy": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Dedup Policy"
    },
    "evidence_status": {
      "$ref": "#/$defs/EvidenceStatus"
    },
    "expected_cardinality": {
      "enum": [
        "1:1",
        "N:1",
        "1:N",
        "N:M"
      ],
      "title": "Expected Cardinality",
      "type": "string"
    },
    "fanout_check_id": {
      "title": "Fanout Check Id",
      "type": "string"
    },
    "join_id": {
      "pattern": "^JC-[0-9]{3,}$",
      "title": "Join Id",
      "type": "string"
    },
    "keys": {
      "items": {
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "type": "string"
          }
        ],
        "type": "array"
      },
      "minItems": 1,
      "title": "Keys",
      "type": "array"
    },
    "left": {
      "title": "Left",
      "type": "string"
    },
    "right": {
      "title": "Right",
      "type": "string"
    },
    "temporal_predicate": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Temporal Predicate"
    },
    "unmatched_left": {
      "enum": [
        "UNKNOWN_MEMBER",
        "QUARANTINE",
        "FAIL"
      ],
      "title": "Unmatched Left",
      "type": "string"
    }
  },
  "required": [
    "join_id",
    "left",
    "right",
    "keys",
    "temporal_predicate",
    "expected_cardinality",
    "unmatched_left",
    "dedup_policy",
    "fanout_check_id",
    "evidence_status"
  ],
  "title": "JoinContract",
  "type": "object"
}
