{
  "$defs": {
    "ColumnContract": {
      "additionalProperties": false,
      "properties": {
        "classification": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/Unknown"
            },
            {
              "$ref": "#/$defs/NotApplicable"
            }
          ],
          "title": "Classification"
        },
        "domain": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain"
        },
        "logical_type": {
          "title": "Logical Type",
          "type": "string"
        },
        "meaning": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Meaning"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Name",
          "type": "string"
        },
        "nullable": {
          "title": "Nullable",
          "type": "boolean"
        },
        "observed_values": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Values"
        },
        "timezone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timezone"
        }
      },
      "required": [
        "name",
        "logical_type",
        "nullable",
        "classification"
      ],
      "title": "ColumnContract",
      "type": "object"
    },
    "EvidenceStatus": {
      "enum": [
        "ORIGINAL_ONLY",
        "PROPOSED",
        "OWNER_CONFIRMED",
        "CATALOG_VERIFIED",
        "PROFILE_VERIFIED",
        "SYNTHETIC"
      ],
      "title": "EvidenceStatus",
      "type": "string"
    },
    "NotApplicable": {
      "additionalProperties": false,
      "properties": {
        "justification": {
          "minLength": 1,
          "title": "Justification",
          "type": "string"
        },
        "kind": {
          "const": "NOT_APPLICABLE",
          "default": "NOT_APPLICABLE",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "justification"
      ],
      "title": "NotApplicable",
      "type": "object"
    },
    "Unknown": {
      "additionalProperties": false,
      "properties": {
        "issue_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Issue Id"
        },
        "kind": {
          "const": "UNKNOWN",
          "default": "UNKNOWN",
          "title": "Kind",
          "type": "string"
        },
        "question": {
          "anyOf": [
            {
              "pattern": "^Q-[0-9]{2}[a-z]?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Question"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "reason"
      ],
      "title": "Unknown",
      "type": "object"
    }
  },
  "$id": "metrics_pipeline_harness/source_contract.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "business_keys": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Business Keys",
      "type": "array"
    },
    "columns": {
      "items": {
        "$ref": "#/$defs/ColumnContract"
      },
      "minItems": 1,
      "title": "Columns",
      "type": "array"
    },
    "delete_representation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/Unknown"
        },
        {
          "$ref": "#/$defs/NotApplicable"
        }
      ],
      "title": "Delete Representation"
    },
    "delivery_mode": {
      "enum": [
        "SNAPSHOT",
        "APPEND",
        "CDC",
        "MIXED"
      ],
      "title": "Delivery Mode",
      "type": "string"
    },
    "engine": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/Unknown"
        },
        {
          "$ref": "#/$defs/NotApplicable"
        }
      ],
      "title": "Engine"
    },
    "event_timestamp": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/Unknown"
        },
        {
          "$ref": "#/$defs/NotApplicable"
        }
      ],
      "title": "Event Timestamp"
    },
    "evidence_status": {
      "$ref": "#/$defs/EvidenceStatus"
    },
    "extraction_boundary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/Unknown"
        },
        {
          "$ref": "#/$defs/NotApplicable"
        }
      ],
      "title": "Extraction Boundary"
    },
    "fixture": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fixture"
    },
    "grain": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Grain",
      "type": "array"
    },
    "history_available": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/Unknown"
        },
        {
          "$ref": "#/$defs/NotApplicable"
        }
      ],
      "title": "History Available"
    },
    "ordering": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/Unknown"
        },
        {
          "$ref": "#/$defs/NotApplicable"
        }
      ],
      "title": "Ordering"
    },
    "owner": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/Unknown"
        },
        {
          "$ref": "#/$defs/NotApplicable"
        }
      ],
      "title": "Owner"
    },
    "schema_version": {
      "const": "source_contract/1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_id": {
      "pattern": "^[A-Za-z][\\w]*(\\.[A-Za-z_][\\w]*){1,3}$",
      "title": "Source Id",
      "type": "string"
    },
    "update_timestamp": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/Unknown"
        },
        {
          "$ref": "#/$defs/NotApplicable"
        }
      ],
      "title": "Update Timestamp"
    }
  },
  "required": [
    "schema_version",
    "source_id",
    "evidence_status",
    "engine",
    "owner",
    "delivery_mode",
    "grain",
    "business_keys",
    "ordering",
    "delete_representation",
    "event_timestamp",
    "update_timestamp",
    "history_available",
    "extraction_boundary",
    "columns"
  ],
  "title": "SourceContract",
  "type": "object"
}
